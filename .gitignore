# Secrets — never commit. Create .env yourself; see .env.example.
.env
.env.*
!.env.example

# Run outputs and caches
runs/
_cache/
__pycache__/
*.pyc

# Built ground truth is regenerable from the dataset in one command:
#   python3 scripts/build_gt.py --dataset <path>
gt/fatura.jsonl

# venvs live outside the repo (see setup.sh); ignore any that appear anyway
.venv*
venv/

# OS / tooling cruft
.DS_Store
.pytest_cache/

# Local run logs
logs/

# Scratch: old adapters, probes, .bak files staged for removal
_to_delete/

# Built ground truth (17MB, regenerable like gt/fatura.jsonl). The path moved into a
# per-dataset subdirectory; the old flat pattern silently stopped matching.
gt/invoice/fatura/ground_truth.jsonl

# Built ground truth for the newer datasets (same rule as gt/invoice/fatura above:
# large and regenerable via scripts/build_gt.py). Manifests and coverage stay tracked.
gt/invoice/fatura_verbatim/ground_truth.jsonl
gt/_backup_*/

# Scratch probes and instrumentation spikes written during scoring investigations
_*.py
!__init__.py
_cells.json
*.bak
*.bak2

# Long-form article drafts kept locally, not part of the harness
Claude outputs/
